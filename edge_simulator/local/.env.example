# Copy this file to .env and fill in your values.
# .env is gitignored — never commit it.

# from: terraform output iot_endpoint  (infrastructure/)
IOT_ENDPOINT=xxxxxxxxxxxxxx-ats.iot.us-east-1.amazonaws.com

# must match infrastructure/terraform.tfvars: hmac_secret
# leave unset to send unsigned payloads (a startup warning will remind you)
HMAC_SECRET=

# --- everything below has a working default — only set to override ---

# which device to publish as is a per-run choice, not an env default:
#   python publish_to_iot.py --client-id edge-device-002 ...
# IOT_CLIENT_ID=edge-device-001

# IOT_CERT=./certs/{device_id}/cert.pem
# IOT_KEY=./certs/{device_id}/private.key
# IOT_ROOT_CA=./certs/root-CA.crt
# IOT_TOPIC=grid/{device_id}/telemetry
